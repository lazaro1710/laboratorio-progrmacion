
int[,] escuela = new int[2, 3]; 
int alumnos = 0;


static int ConsoleIntTryParse(string text)
{
    int output = 0;
    bool flag = false;
    string? input;
    while (flag == false)
    {
        Console.WriteLine($"Por favor, ingrese Cantidad de {text}");
        input = Console.ReadLine();

        if (int.TryParse(input, out int num))
        {
            output = num;
            flag = true;
            if (output < 0)
            {
                Console.WriteLine("Ingrese un valor válido (positivo)");
                flag = false;
            }
        }
        else
        {
            Console.WriteLine("Ingrese un valor numérico válido");
            flag = false;
        }
    }
    return output;
}


